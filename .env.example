# ===== 应用 =====
APP_NAME=BartenderAI
ENV=dev
SECRET_KEY=generate-a-random-secret-at-least-32-characters

# ===== LLM（阿里云百炼 Qwen / DeepSeek，支持多个供应商）=====
# DeepSeek 作为全局主力；失败、限流或超时时再依次切到 Qwen / 本地模型
QWEN_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：本地 OpenAI-compatible 服务（Ollama / LM Studio / vLLM）
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LLM_PROVIDER_PRIORITY=deepseek,qwen,local
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_CIRCUIT_BREAKER_SECONDS=60

# 公网检索补充（Tavily，https://tavily.com 免费注册拿 key；留空则 search_web 提示未启用）
TAVILY_API_KEY=

# 备用模型（降级容灾）
FALLBACK_MODEL=deepseek-chat

# 多模态（拍照识别库存）
QWVL_MODEL=qwen-vl-plus

# 本地重排模型
RERANK_MODEL_PATH=BAAI/bge-reranker-v2-m3
EMBED_MODEL_PATH=BAAI/bge-m3

# 模型下载：优先走 ModelScope（阿里云，国内稳定）自动下载到 models/<slug>/。
# 系统自动探测本地缓存，本地没有才联网。
# HF_ENDPOINT 仅作留档：hf-mirror.com 会重定向到 huggingface.co（国内不可达），
# 已用 ModelScope 兜底替代，一般不需要改。
HF_ENDPOINT=https://hf-mirror.com
# 若已手动下载模型到本地，可改为本地目录，如 EMBED_MODEL_PATH=D:/models/bge-m3

# ===== 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=bartenderai
DATABASE_URL=sqlite:///data/app.db

# ===== 邮件（开发默认 Mailpit；生产改为真实 SMTP）=====
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BartenderAI <noreply@bartenderai.local>
SMTP_STARTTLS=false
SMTP_SSL=false

# ===== 向量库 Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== 可观测 Langfuse =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ===== 安全（M6）=====
# CORS 白名单（逗号分隔），* = 全放（仅 dev）
CORS_ORIGINS=*
# 对话内容落库加密（密钥派生自 SECRET_KEY，改了旧数据读不回）
ENCRYPT_CHAT=true
# 限流（次/分钟）
CHAT_RATE_LIMIT=20
GEN_RATE_LIMIT=10
LOGIN_RATE_LIMIT=10
MAX_UPLOAD_MB=8
AGENT_TIMEOUT_SECONDS=60

# ===== 其他 =====
RATE_LIMIT_PER_MIN=20
LOG_LEVEL=INFO
